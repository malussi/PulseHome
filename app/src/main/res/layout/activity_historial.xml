<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_fondo"
    android:orientation="vertical"
    tools:context=".HistorialActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdministracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administración"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNombreApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PulseHome"
                android:textColor="@color/ph_texto"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloPantalla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial alertas"
                android:textColor="@color/ph_texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConexion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema conectado"
                android:textColor="@color/ph_normal_texto"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/chipTodos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/ph_primario"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvChipTodos"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Todos"
                android:textColor="@color/ph_texto"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/chipTemp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/ph_superficie"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvChipTemp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Temp"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/chipGas"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/ph_superficie"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvChipGas"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Gas"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/chipHum"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            app:cardBackgroundColor="@color/ph_superficie"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvChipHum"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Hum"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvGrupoHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoy"
                android:textColor="@color/ph_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFechaHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Jueves 8 de octubre"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/filaEvento1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/puntoEvento1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="@color/ph_alerta"
                        app:cardCornerRadius="7dp"
                        app:cardElevation="0dp" />

                    <View
                        android:id="@+id/lineaEvento1"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/ph_superficie_alta" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEvento1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/ph_superficie"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvEstadoEvento1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Alerta"
                                android:textColor="@color/ph_alerta_texto"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHoraEvento1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14:25"
                                android:textColor="@color/ph_texto_secundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTituloEvento1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Humedad baja"
                            android:textColor="@color/ph_texto"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvDetalleEvento1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Casa Abuela · 28%"
                            android:textColor="@color/ph_texto_secundario"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvVerDetalles1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="Ver detalles"
                            android:textColor="@color/ph_primario_claro"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filaEvento2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/puntoEvento2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="@color/ph_normal"
                        app:cardCornerRadius="7dp"
                        app:cardElevation="0dp" />

                    <View
                        android:id="@+id/lineaEvento2"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/ph_superficie_alta" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEvento2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/ph_superficie"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvEstadoEvento2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Normal"
                                android:textColor="@color/ph_normal_texto"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHoraEvento2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="09:10"
                                android:textColor="@color/ph_texto_secundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTituloEvento2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Temperatura normal"
                            android:textColor="@color/ph_texto"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvDetalleEvento2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Casa Abuela · 24°C"
                            android:textColor="@color/ph_texto_secundario"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvVerDetalles2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="Ver detalles"
                            android:textColor="@color/ph_primario_claro"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvGrupoAyer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ayer"
                android:textColor="@color/ph_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFechaAyer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Miércoles 7 de octubre"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/filaEvento3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/puntoEvento3"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="@color/ph_alerta"
                        app:cardCornerRadius="7dp"
                        app:cardElevation="0dp" />

                    <View
                        android:id="@+id/lineaEvento3"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/ph_superficie_alta" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEvento3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/ph_superficie"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvEstadoEvento3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Alerta"
                                android:textColor="@color/ph_alerta_texto"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHoraEvento3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15:50"
                                android:textColor="@color/ph_texto_secundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTituloEvento3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Temperatura alta"
                            android:textColor="@color/ph_texto"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvDetalleEvento3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Casa Abuela · 31°C"
                            android:textColor="@color/ph_texto_secundario"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvVerDetalles3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="Ver detalles"
                            android:textColor="@color/ph_primario_claro"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraNavegacion"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/ph_primario"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Inicio" app:srcCompat="@mipmap/ic_inicio"
            android:padding="16dp" />

        <ImageView
            android:id="@+id/navHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="1"
            android:contentDescription="Historial" app:srcCompat="@mipmap/ic_historial"
            android:padding="16dp" />

        <ImageView
            android:id="@+id/navNotificaciones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Notificaciones" app:srcCompat="@mipmap/ic_notificaciones"
            android:padding="16dp" />

        <ImageView
            android:id="@+id/navDispositivos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Dispositivos" app:srcCompat="@mipmap/ic_dispositivos"
            android:padding="16dp" />

        <ImageView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Perfil" app:srcCompat="@mipmap/ic_perfil"
            android:padding="16dp" />
    </LinearLayout>

</LinearLayout>