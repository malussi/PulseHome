<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_fondo"
    android:orientation="vertical"
    tools:context=".PerfilActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdministracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administración"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNombreApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PulseHome"
                android:textColor="@color/ph_texto"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloPantalla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/ph_texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConexion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema conectado"
                android:textColor="@color/ph_normal_texto"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                app:cardBackgroundColor="@color/ph_primario"
                app:cardCornerRadius="48dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto de perfil" app:srcCompat="@mipmap/ic_perfil"
                    android:padding="24dp" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Jorge López Araya"
                android:textColor="@color/ph_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRolUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Cuidador"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="14sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCambiarCuenta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/imgCambiarCuenta"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Icono cambiar cuenta" app:srcCompat="@mipmap/ic_cambiar_cuenta" />

                    <TextView
                        android:id="@+id/tvCambiarCuenta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Cambiar cuenta"
                        android:textColor="@color/ph_texto"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/imgFlechaCambiarCuenta"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Flecha" app:srcCompat="@mipmap/ic_flecha" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCambiarContrasena"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/imgCambiarContrasena"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Icono cambiar contraseña" app:srcCompat="@mipmap/ic_candado" />

                    <TextView
                        android:id="@+id/tvCambiarContrasena"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Cambiar contraseña"
                        android:textColor="@color/ph_texto"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/imgFlechaCambiarContrasena"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Flecha" app:srcCompat="@mipmap/ic_flecha" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCambiarFoto"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/imgCambiarFoto"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Icono cambiar foto" app:srcCompat="@mipmap/ic_camara" />

                    <TextView
                        android:id="@+id/tvCambiarFoto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Cambiar foto de perfil"
                        android:textColor="@color/ph_texto"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/imgFlechaCambiarFoto"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Flecha" app:srcCompat="@mipmap/ic_flecha" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardControlNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/imgControlNotificaciones"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Icono control de notificaciones" app:srcCompat="@mipmap/ic_control_notificaciones" />

                    <TextView
                        android:id="@+id/tvControlNotificaciones"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Control de notificaciones"
                        android:textColor="@color/ph_texto"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/imgFlechaControlNotificaciones"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Flecha" app:srcCompat="@mipmap/ic_flecha" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardResumenSemanal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/imgResumenSemanal"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Icono resumen semanal" app:srcCompat="@mipmap/ic_resumen_semanal" />

                    <TextView
                        android:id="@+id/tvResumenSemanal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Resumen semanal"
                        android:textColor="@color/ph_texto"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/imgFlechaResumenSemanal"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Flecha" app:srcCompat="@mipmap/ic_flecha" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardEstadoCuenta"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/imgEstadoCuenta"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Icono estado de cuenta" app:srcCompat="@mipmap/ic_estado_cuenta" />

                    <TextView
                        android:id="@+id/tvEstadoCuenta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Estado de cuenta"
                        android:textColor="@color/ph_texto"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/imgFlechaEstadoCuenta"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Flecha" app:srcCompat="@mipmap/ic_flecha" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/imgCerrarSesion"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Icono cerrar sesión" app:srcCompat="@mipmap/ic_cerrar_sesion" />

                    <TextView
                        android:id="@+id/tvCerrarSesion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Cerrar sesión"
                        android:textColor="@color/ph_alerta_texto"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraNavegacion"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/ph_primario"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Inicio" app:srcCompat="@mipmap/ic_inicio"
            android:padding="16dp" />

        <ImageView
            android:id="@+id/navHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Historial" app:srcCompat="@mipmap/ic_historial"
            android:padding="16dp" />

        <ImageView
            android:id="@+id/navNotificaciones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Notificaciones" app:srcCompat="@mipmap/ic_notificaciones"
            android:padding="16dp" />

        <ImageView
            android:id="@+id/navDispositivos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Dispositivos" app:srcCompat="@mipmap/ic_dispositivos"
            android:padding="16dp" />

        <ImageView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="1"
            android:contentDescription="Perfil" app:srcCompat="@mipmap/ic_perfil"
            android:padding="16dp" />
    </LinearLayout>

</LinearLayout>