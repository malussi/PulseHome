<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_fondo"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".RegistroActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="Logo de PulseHome"
        app:srcCompat="@mipmap/logo_pulsehome" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Crear cuenta"
        android:textColor="@color/ph_texto"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Regístrate para cuidar a tu familia"
        android:textColor="@color/ph_texto_secundario"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvEtiquetaNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Nombre"
        android:textColor="@color/ph_texto_secundario"
        android:textSize="14sp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardNombre"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="@color/ph_superficie"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="Tu nombre completo"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ph_texto"
            android:textColorHint="@color/ph_texto_secundario"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvEtiquetaCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Correo"
        android:textColor="@color/ph_texto_secundario"
        android:textSize="14sp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCorreo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="@color/ph_superficie"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="nombre@correo.cl"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ph_texto"
            android:textColorHint="@color/ph_texto_secundario"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvEtiquetaContrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Contraseña"
        android:textColor="@color/ph_texto_secundario"
        android:textSize="14sp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContrasena"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="@color/ph_superficie"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <EditText
            android:id="@+id/etContrasena"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="Crea una contraseña"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ph_texto"
            android:textColorHint="@color/ph_texto_secundario"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvEtiquetaRepetir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Repetir contraseña"
        android:textColor="@color/ph_texto_secundario"
        android:textSize="14sp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardRepetir"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="@color/ph_superficie"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <EditText
            android:id="@+id/etRepetirContrasena"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="Repite tu contraseña"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ph_texto"
            android:textColorHint="@color/ph_texto_secundario"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCrearCuenta"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/ph_primario"
        android:text="Crear cuenta"
        android:textAllCaps="false"
        android:textColor="@color/ph_texto"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

    <TextView
        android:id="@+id/tvIrLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="¿Ya tienes cuenta? Inicia sesión"
        android:textColor="@color/ph_primario_claro"
        android:textSize="14sp" />

</LinearLayout>