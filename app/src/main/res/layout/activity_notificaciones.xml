<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_fondo"
    android:orientation="vertical"
    tools:context=".NotificacionesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdministracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administración"
                android:textColor="@color/ph_texto_secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNombreApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PulseHome"
                android:textColor="@color/ph_texto"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloPantalla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Centro de notificaciones"
                android:textColor="@color/ph_texto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConexion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema conectado"
                android:textColor="@color/ph_normal_texto"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvGrupoHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Hoy"
                android:textColor="@color/ph_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardNotificacion1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardIconoNotificacion1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/ph_primario"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgNotificacion1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Icono de acceso a sensor"
                            android:padding="12dp"
                            app:srcCompat="@mipmap/ic_sensor" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloNotificacion1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Acceso a Sensor Gas"
                            android:textColor="@color/ph_texto"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDescripcionNotificacion1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Se consultó el sensor de gas desde tu cuenta"
                            android:textColor="@color/ph_texto_secundario"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHoraNotificacion1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="16:20"
                        android:textColor="@color/ph_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardNotificacion2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardIconoNotificacion2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/ph_primario"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgNotificacion2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Icono de cambio de contraseña"
                            android:padding="12dp"
                            app:srcCompat="@mipmap/ic_candado" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloNotificacion2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cambio de contraseña"
                            android:textColor="@color/ph_texto"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDescripcionNotificacion2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tu contraseña fue actualizada correctamente"
                            android:textColor="@color/ph_texto_secundario"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHoraNotificacion2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="12:50"
                        android:textColor="@color/ph_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvGrupoAyer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="Ayer"
                android:textColor="@color/ph_texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardNotificacion3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/ph_superficie"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardIconoNotificacion3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/ph_primario"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgNotificacion3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Icono de actualización"
                            android:padding="12dp"
                            app:srcCompat="@mipmap/ic_actualizacion" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTituloNotificacion3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Actualización disponible"
                            android:textColor="@color/ph_texto"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDescripcionNotificacion3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Hay una nueva versión de PulseHome"
                            android:textColor="@color/ph_texto_secundario"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHoraNotificacion3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="22:30"
                        android:textColor="@color/ph_texto_secundario"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraNavegacion"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/ph_primario"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Inicio"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_inicio" />

        <ImageView
            android:id="@+id/navHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Historial"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_historial" />

        <ImageView
            android:id="@+id/navNotificaciones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="1"
            android:contentDescription="Notificaciones"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_notificaciones" />

        <ImageView
            android:id="@+id/navDispositivos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Dispositivos"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_dispositivos" />

        <ImageView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Perfil"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_perfil" />
    </LinearLayout>

</LinearLayout>