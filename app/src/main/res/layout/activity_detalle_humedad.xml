<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ph_detalle_fin"
    android:orientation="vertical"
    tools:context=".DetalleHumedadActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/imgVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Volver"
            android:padding="12dp"
            app:srcCompat="@mipmap/ic_volver" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSensores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensores"
                android:textColor="@color/ph_blanco_80"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTituloSensor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensor Humedad"
                android:textColor="@color/ph_texto"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgCompartir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Compartir"
            android:padding="12dp"
            app:srcCompat="@mipmap/ic_compartir" />

        <ImageView
            android:id="@+id/imgMas"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Más opciones"
            android:padding="12dp"
            app:srcCompat="@mipmap/ic_mas" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLectura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ph_tarjeta_clara"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardIconoSensor"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardBackgroundColor="@color/ph_primario"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imgSensor"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Sensor Humedad"
                                android:padding="12dp"
                                app:srcCompat="@mipmap/ic_humedad" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNombreSensor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sensor Humedad"
                                android:textColor="@color/ph_texto_oscuro"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvUbicacionEstado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Casa Abuela · Activo"
                                android:textColor="@color/ph_texto_oscuro_secundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardConexion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/ph_normal"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/tvConexion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="12dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="4dp"
                                android:text="En línea"
                                android:textColor="@color/ph_texto"
                                android:textSize="12sp" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="28%"
                        android:textColor="@color/ph_texto_oscuro"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvUltimaLectura"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Última lectura hace 3 min"
                            android:textColor="@color/ph_texto_oscuro_secundario"
                            android:textSize="12sp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardVariacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/ph_dato_claro"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/tvVariacion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="12dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="4dp"
                                android:text="↗ +0.5%"
                                android:textColor="@color/ph_texto_oscuro"
                                android:textSize="12sp" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/ph_tarjeta_clara"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTituloDetalles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:text="Detalles"
                        android:textColor="@color/ph_texto_oscuro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardUbicacion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/ph_dato_claro"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvEtiquetaUbicacion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ubicación"
                                    android:textColor="@color/ph_texto_oscuro_secundario"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvUbicacion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Casa Abuela"
                                    android:textColor="@color/ph_texto_oscuro"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardEstado"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/ph_dato_claro"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvEtiquetaEstado"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Estado"
                                    android:textColor="@color/ph_texto_oscuro_secundario"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvEstado"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Activo"
                                    android:textColor="@color/ph_texto_oscuro"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardRango"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/ph_dato_claro"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvEtiquetaRango"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Alerta si baja de"
                                    android:textColor="@color/ph_texto_oscuro_secundario"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvRango"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="30%"
                                    android:textColor="@color/ph_texto_oscuro"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardSensor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/ph_dato_claro"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvEtiquetaSensor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sensor"
                                    android:textColor="@color/ph_texto_oscuro_secundario"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvModeloSensor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DHT22"
                                    android:textColor="@color/ph_texto_oscuro"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecomendaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/ph_tarjeta_clara"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvTituloRecomendaciones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recomendaciones"
                        android:textColor="@color/ph_texto_oscuro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRecomendacion1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Se sugiere mantenerse alejado de zonas con mucho polvo."
                        android:textColor="@color/ph_texto_oscuro"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRecomendacion2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Revise cada cierto tiempo las condiciones de su hogar."
                        android:textColor="@color/ph_texto_oscuro"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgAnterior"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="Sensor anterior"
                    android:padding="12dp"
                    app:srcCompat="@mipmap/ic_anterior" />

                <ImageView
                    android:id="@+id/imgSiguiente"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Sensor siguiente"
                    android:padding="12dp"
                    app:srcCompat="@mipmap/ic_siguiente" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/barraNavegacion"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/ph_primario"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="1"
            android:contentDescription="Inicio"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_inicio" />

        <ImageView
            android:id="@+id/navHistorial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Historial"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_historial" />

        <ImageView
            android:id="@+id/navNotificaciones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Notificaciones"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_notificaciones" />

        <ImageView
            android:id="@+id/navDispositivos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Dispositivos"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_dispositivos" />

        <ImageView
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alpha="0.7"
            android:contentDescription="Perfil"
            android:padding="16dp"
            app:srcCompat="@mipmap/ic_perfil" />
    </LinearLayout>

</LinearLayout>